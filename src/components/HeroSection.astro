<section class="showcase-hero" id="home" aria-labelledby="hero-title">
    <div class="showcase-hero__panel">
        <div class="showcase-hero__copy">
            <p class="showcase-hero__eyebrow">AI COMPANION <span aria-hidden="true">/</span> VIVIAN</p>
            <h1 id="hero-title">A little world<br />with <em>Vivian.</em></h1>
            <p class="showcase-hero__summary">A companion who remembers the little things. Talk, laugh, and make every day a story of your own.</p>
            <div class="showcase-hero__actions">
                <span class="showcase-hero__button showcase-hero__button--primary showcase-hero__button--soon" aria-label="Vivian is coming soon">Coming soon <span aria-hidden="true">✦</span></span>
                <a class="showcase-hero__button showcase-hero__button--secondary" href="https://github.com/celestial-sora/ai-waifu" target="_blank" rel="noopener noreferrer">Explore the project</a>
            </div>
        </div>

        <figure class="showcase-hero__preview">
            <div class="showcase-hero__stage" role="img" aria-label="Vivian interface mockups on an iPad and a Samsung Galaxy S24 Ultra">
                <div class="showcase-hero__tablet" aria-hidden="true">
                    <div class="showcase-hero__tablet-screen">
                        <div class="showcase-hero__tablet-app">
                            <div class="showcase-hero__desktop-nav">
                                <div class="showcase-hero__app-mark">vivian<span>.</span></div>
                                <span class="showcase-hero__nav-current"><i></i> Home</span>
                                <span class="showcase-hero__nav-link">Moments</span>
                                <div class="showcase-hero__nav-bottom"><i></i> Here for you</div>
                            </div>
                            <div class="showcase-hero__desktop-content">
                                <div class="showcase-hero__desktop-top"><span>YOUR LITTLE CORNER</span><span>✦</span></div>
                                <div class="showcase-hero__desktop-message">
                                    <span class="showcase-hero__small-label">A LITTLE SPACE FOR YOU</span>
                                    <strong>Hi, I'm<br />Vivian.</strong>
                                    <span>I'm happy you're here.<br />How was your day?</span>
                                    <div class="showcase-hero__desktop-reply">Tell me about it <b>↗</b></div>
                                </div>
                                <img src={import.meta.env.BASE_URL + "vivian-character.webp"} alt="" fetchpriority="high" decoding="async" />
                            </div>
                        </div>
                        <div class="showcase-hero__tablet-home"></div>
                    </div>
                </div>
                <div class="showcase-hero__phone" aria-hidden="true">
                    <div class="showcase-hero__phone-screen">
                        <div class="showcase-hero__camera"></div>
                        <div class="showcase-hero__phone-header"><span>‹</span><strong>Vivian</strong><i></i></div>
                        <div class="showcase-hero__phone-portrait"><img src={import.meta.env.BASE_URL + "vivian-character.webp"} alt="" decoding="async" /></div>
                        <div class="showcase-hero__phone-chat"><span>VIVIAN · JUST NOW</span><p>You're here! Tell me about your day ♡</p></div>
                        <div class="showcase-hero__phone-input"><span>Say something...</span><b>↗</b></div>
                        <div class="showcase-hero__phone-home"></div>
                    </div>
                </div>
            </div>
        </figure>
    </div>
    <a class="showcase-hero__scroll" href="#about">Scroll to explore <span aria-hidden="true">↓</span></a>
</section>

