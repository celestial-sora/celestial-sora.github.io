<button class="scroll-top" id="scrollTopBtn" type="button" aria-label="Back to top"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13V3M4 7l4-4 4 4" /></svg></button>
<script>
    const scrollTop = document.getElementById('scrollTopBtn');
    window.addEventListener('scroll', () => scrollTop?.classList.toggle('is-visible', window.scrollY > 600), { passive: true });
    scrollTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>
