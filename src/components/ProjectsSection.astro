---
const projects = [
    { number: '01', type: 'AI ROLEPLAY · SEKAIRA', title: 'Oonchai', description: 'An AI roleplay platform for creating characters, exploring stories, and building conversations that remember you.', tags: ['AI Roleplay', 'Characters', 'Memory'], primary: 'Open project', href: 'https://oonchai.vercel.app/', image: 'oonchai-banner.svg' },
    { number: '02', type: 'AI COMPANION', title: 'Vivian', description: 'A cozy AI companion with Live2D, memory, voice, and vision — built to stay by your side.', tags: ['Live2D', 'Memory', 'Voice + Vision'], primary: 'View project', href: 'https://github.com/celestial-sora/ai-waifu', image: 'vivian-banner-v2.jpg' },
];
---
<section class="section-shell projects-section" id="projects">
    <div class="section-heading section-heading--row"><div><span class="eyebrow">Selected work</span><h2>Things I make<br /><em>when curiosity wins.</em></h2></div><p>A few projects shaped by a fascination with AI, stories, and thoughtful interfaces.</p></div>
    <div class="project-grid">
        {projects.map((project) => (
            <article class="project-card material-card">
                <div class={`project-banner ${project.image ? 'project-banner--image' : project.accent}`}>
                    {project.image ? <img class="project-banner__image" src={import.meta.env.BASE_URL + project.image} alt={`${project.title} project banner`} /> : <><span class="project-banner__index">{project.number} / PROJECT</span><svg class="project-banner__mark" viewBox="0 0 16 16" aria-hidden="true"><path d="m8 1 1.2 5.8L15 8l-5.8 1.2L8 15 6.8 9.2 1 8l5.8-1.2L8 1Z" /></svg><strong>{project.title}</strong></>}
                </div>
                <div class="project-card__body"><span class="card-kicker">{project.type}</span><h3>{project.title}</h3><p>{project.description}</p><div class="tag-list">{project.tags.map((tag) => <span>{tag}</span>)}</div><a class="button button--primary" href={project.href} target="_blank" rel="noopener noreferrer">{project.primary} <svg class="icon-inline" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" /></svg></a></div>
            </article>
        ))}
    </div>
</section>
